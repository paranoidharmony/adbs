#!/system/bin/sh
# 不修改系统 shell，也不使用 Termux 的私有路径。
set -eu
export HOME=/data/local/tmp/adbshome ZDOTDIR=/data/local/tmp/adbshome
export PATH="$HOME/.local/bin:$PATH" LD_LIBRARY_PATH="$HOME/.local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export TERMINFO="$HOME/.local/share/terminfo" TERM=xterm-256color
# Termux 的默认 CA 路径在应用私有目录；使用随仓库分发的信任库。
export CURL_CA_BUNDLE="$HOME/.local/etc/tls/cert.pem"
export TMPDIR="$HOME/.cache/tmp" TMPPREFIX="$HOME/.cache/tmp/zsh"
umask 077
mkdir -p "$TMPDIR" "$HOME/.local/state"
# adbd 创建的目录可能允许组写；保留 compinit 的安全检查。
/system/bin/find "$HOME/.local/share/zsh" -type d -exec /system/bin/chmod go-w '{}' +
cd "$HOME"
exec "$HOME/.local/bin/zsh" -i "$@"
