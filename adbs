#!/usr/bin/env bash
# 将仓库维护的 HOME 同步给 Android shell 用户，再启动交互式 Zsh。
set -euo pipefail
cd -- "$(dirname -- "$(realpath -- "$0")")"
usage() { printf '%s\n' '用法：adbs [-s 设备序列号] [--check]' '      adbs --update'; }
# 更新在主机完成，不需要手机在线，只允许快进以避免意外合并。
if [[ $# == 1 && $1 == --update ]]; then
  git pull --ff-only
  exec ./install.sh
fi
a=(adb)
if [[ ${1:-} == -s && $# -ge 2 ]]; then a+=(-s "$2"); shift 2; fi
case $#:${1:-} in
  0:) check=false ;;
  1:--check) check=true ;;
  1:--help|1:-h) usage; exit ;;
  *) usage >&2; exit 2 ;;
esac
abi=$("${a[@]}" shell getprop ro.product.cpu.abi)
[[ ${abi%$'\r'} == arm64-v8a ]] || { echo "仅支持 arm64-v8a，当前设备为 $abi" >&2; exit 1; }
remote=/data/local/tmp/adbshome
"${a[@]}" shell "umask 077; mkdir -p $remote"
# 指定父目录，避免重复连接时出现 adbshome/adbshome。
"${a[@]}" push --sync adbshome /data/local/tmp/ >&2
start="/system/bin/sh $remote/.local/libexec/start-zsh"
if $check; then
  exec "${a[@]}" shell -T "$start -c 'source \"\$HOME/.local/libexec/check.zsh\"'"
fi
exec "${a[@]}" shell -t "$start"
