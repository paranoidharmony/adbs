#!/usr/bin/env bash
# 只同步 Android 共享运行环境，用户 HOME 和工作区由设备维护。
set -euo pipefail
cd -- "$(dirname -- "$(realpath -- "$0")")"
usage() { printf '%s\n' '用法：adbs [-s 设备序列号] [--check]' '      adbs --update'; }
# 更新在主机完成，不需要手机在线，只允许快进以避免意外合并。
if [[ $# == 1 && $1 == --update ]]; then
  git pull --ff-only
  exec ./install.sh
fi
a=(adb)
if [[ ${1:-} == -s && $# -ge 2 ]]; then a+=(-s "$2"); shift 2; fi
case $#:${1:-} in
  0:) check=false ;;
  1:--check) check=true ;;
  1:--help|1:-h) usage; exit ;;
  *) usage >&2; exit 2 ;;
esac
abi=$("${a[@]}" shell getprop ro.product.cpu.abi)
[[ ${abi%$'\r'} == arm64-v8a ]] || { echo "仅支持 arm64-v8a，当前设备为 $abi" >&2; exit 1; }
remote=/data/local/tmp/adbs
"${a[@]}" shell "umask 077; mkdir -p $remote/home"
# 只压缩成功时的传输统计；失败保留 adb 原始诊断和退出码。
if sync_log=$("${a[@]}" push --sync android/usr android/etc "$remote/" 2>&1); then
  printf '%s\n' "$sync_log" | awk '
    /^android\/(usr|etc)\/?: [0-9]+ files? pushed, [0-9]+ skipped\./ { dirs += $2; next }
    /^[0-9]+ files? pushed, [0-9]+ skipped\./ { total = $1; have_total = 1; next }
    NF { print }
    END {
      count = have_total ? total : dirs
      if (count > 0) printf "Synced %d file%s.\n", count, (count == 1 ? "" : "s")
    }' >&2
else
  status=$?; printf '%s\n' "$sync_log" >&2; exit "$status"
fi
start="/system/bin/sh $remote/usr/libexec/start-zsh"
if $check; then
  exec "${a[@]}" shell -T "$start --check"
fi
printf '%s\n' 'Welcome to adbs (Android Zsh).' >&2
exec "${a[@]}" shell -t "$start"
